{
    "name": "hbenabdallah/sherpa",
    "description": "A coding agent for the terminal: reads, searches, edits and tests your code with an online model (Anthropic, OpenAI-compatible) or a local one (Ollama)",
    "type": "project",
    "keywords": [
        "ai",
        "agent",
        "coding-agent",
        "llm",
        "cli",
        "terminal",
        "mcp",
        "rag",
        "ollama",
        "openai",
        "anthropic",
        "symfony",
        "php"
    ],
    "homepage": "https://github.com/hbenabdallah/sherpa",
    "license": "MIT",
    "authors": [
        {
            "name": "Houssem Eddine BENABDALLAH",
            "email": "benabdallahhoussemedine@gmail.com",
            "homepage": "https://github.com/hbenabdallah"
        }
    ],
    "support": {
        "issues": "https://github.com/hbenabdallah/sherpa/issues",
        "source": "https://github.com/hbenabdallah/sherpa"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-posix": "*",
        "doctrine/dbal": "^4.4.4",
        "mcp/sdk": "^0.8.1",
        "nyholm/psr7": "^1.8",
        "symfony/console": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.0.*",
        "symfony/http-client": "8.0.*",
        "symfony/process": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/yaml": "8.0.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "rector": "rector --dry-run",
        "test": "php tests/run.php",
        "check": ["@cs", "@rector", "@stan", "@test"],
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "rector/rector": "^2.8"
    }
}
