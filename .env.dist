USER_ID=1000
GROUP_ID=1000
USER=user
HOME_PATH=/home/user

# Root directory holding the projects Sherpa will work on. Mounted into the
# container at this exact same path so absolute paths stay valid on both sides.
SHERPA_PROJECTS_ROOT=/home/user/workspace

APP_ENV=prod
APP_SECRET=sherpa_secret_change_me

# Where the model runs:
#   api     an online model, at any OpenAI-compatible provider (the default)
#   ollama  a local model served by Ollama
# One choice for the whole machine. `sherpa -b ollama` replaces it for one run;
# /backend changes it from inside a session.
SHERPA_BACKEND=api

# ---- API --------------------------------------------------------------------
# The address up to and including the version segment, for example:
#   https://api.openai.com/v1
#   https://api.mistral.ai/v1
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1                          (Claude, Gemini, Llama… with one key)
#   https://generativelanguage.googleapis.com/v1beta/openai
#   http://localhost:8000/v1                              (vLLM, LM Studio, llama.cpp…)
# Empty, Sherpa asks for it on the first run and keeps it in
# ~/.config/sherpa/config.yaml; set, it wins over what was kept.
SHERPA_API_URL=

# The key. This file is not tracked by git, but exporting it in your shell
# (export SHERPA_API_KEY=…) stays safer: docker compose passes it to the
# container either way. Empty for a server with no authentication.
SHERPA_API_KEY=

# LAST-RESORT model and window, as for Ollama below: on the first run Sherpa
# offers the provider's list and keeps the choice in
# ~/.config/sherpa/config.yaml.
#
# The window is not the model's maximum but Sherpa's budget: every turn sends
# the whole conversation back, so a wider window costs more in long sessions.
SHERPA_API_MODEL=
SHERPA_API_CONTEXT=32768

# ---- Ollama -----------------------------------------------------------------
OLLAMA_URL=http://localhost:11434

# LAST-RESORT model and context window.
#
# These are not the everyday settings: on the first run Sherpa asks which model
# to use and writes the answer to ~/.config/sherpa/config.yaml, which is outside
# the repository and specific to each machine. The order is:
#
#     -b / -m / -c  >  /backend, /model  >  ~/.config/sherpa/config.yaml  >  this file
#
# So the values below only serve non-interactive runs (scripts, CI) and a
# machine that has not chosen anything yet.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CTX=32768
# Idle timeout for inference requests, in seconds.
# Negative = unlimited. Must be negative, not 0 (0 means "no inactivity allowed").
OLLAMA_TIMEOUT=-1

# How long Ollama keeps the model loaded after an answer. Its own default is
# five minutes, which is shorter than reading a diff: on a machine with a
# graphics card, thinking about your next question is enough to have tens of
# gigabytes of weights reloaded before the turn after.
OLLAMA_KEEP_ALIVE=30m

# ---- both backends -----------------------------------------------------------
# Sampling temperature. Sherpa produces structured output only — tool calls,
# JSON, summaries — where variability is not a quality but the failure.
# Deliberately not 0: greedy decoding locks some models into repetition.
SHERPA_TEMPERATURE=0.15

# Cap on one reply, in tokens. Must stay equal to the reserve ContextBudget
# sets aside: both are wired to this same parameter.
SHERPA_MAX_TOKENS=4096

# Cap on one session, in tokens sent and received; 0 for none. Checked before
# every request: one that would go past it is not sent. Prices are declared per
# model in ~/.config/sherpa/config.yaml (see the README).
SHERPA_MAX_SESSION_TOKENS=0

# At the end of a session, Sherpa asks the model what is worth keeping about the
# project: that is how the memory fills up. One more request per session, billed
# like the others with an API. "off" keeps only what was remembered during the
# session (/remember, or the model itself).
SHERPA_FACT_EXTRACTION=on

# Searching the project's documentation: the model that turns it into vectors,
# to find a passage that says the same thing in other words — or in another
# language. Empty: keyword search only. Preferably in
# ~/.config/sherpa/config.yaml (api.embedding_model), which wins.
# For example @cf/baai/bge-m3 at Cloudflare, bge-m3 with Ollama.
SHERPA_EMBEDDING_MODEL=
