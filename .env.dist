USER_ID=1000
GROUP_ID=1000
USER=user
HOME_PATH=/home/user

# Root directory holding the projects Sherpa will work on. Mounted into the
# container at this exact same path so absolute paths stay valid on both sides.
SHERPA_PROJECTS_ROOT=/home/user/workspace

APP_ENV=prod
APP_SECRET=sherpa_secret_change_me

OLLAMA_URL=http://localhost:11434

# Modèle et fenêtre de contexte de DERNIER RECOURS.
#
# Ce ne sont pas les réglages courants : au premier lancement Sherpa demande
# quel modèle utiliser et écrit la réponse dans ~/.config/sherpa/config.yaml,
# qui est hors du dépôt et propre à chaque machine. L'ordre est :
#
#     -m / -c  >  /model  >  ~/.config/sherpa/config.yaml  >  ce fichier
#
# Les valeurs ci-dessous ne servent donc qu'aux exécutions non interactives
# (scripts, CI) et à amorcer une machine qui n'a encore rien choisi.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CTX=32768
# Idle timeout for inference requests, in seconds.
# Negative = unlimited. Must be negative, not 0 (0 means "no inactivity allowed").
OLLAMA_TIMEOUT=-1
