#!/usr/bin/env php
<?php

use App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

if (!is_dir(dirname(__DIR__).'/vendor')) {
    throw new \LogicException('Dependencies missing. Run "composer install".');
}

require_once dirname(__DIR__).'/vendor/autoload_runtime.php';

return function (array $context) {
    $kernel = new Kernel($context['APP_ENV'], (bool) $context['APP_DEBUG']);
    $app = new Application($kernel);
    // `sherpa mcp …` and `sherpa update` are commands of their own; anything
    // else is the session, whose options come straight after the program's name.
    $app->setDefaultCommand('sherpa', !in_array($_SERVER['argv'][1] ?? '', ['mcp', 'update'], true));
    return $app;
};
